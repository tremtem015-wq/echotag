# Copy to .env for local development and adjust as needed.

# Port the web server listens on.
PORT=3000

# Public address used inside QR codes, e.g. https://echotag.vercel.app
# Leave empty to auto-detect the LAN address (good for local testing).
# PUBLIC_BASE_URL=

# How long recordings are kept. Set to 0 to keep them until deleted.
RETENTION_DAYS=30

# Longest recording allowed, in seconds.
MAX_RECORDING_SECONDS=300

# Largest upload accepted, in megabytes. Vercel functions cap request bodies
# at about 4.5 MB, so production defaults to 4 MB and 180 seconds.
# MAX_UPLOAD_MB=25

# Vercel Blob. On Vercel, connecting a Blob store sets BLOB_STORE_ID and the
# SDK uses Vercel's short-lived OIDC token automatically. Locally, set a
# read-write token to use Blob instead of the filesystem.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# BLOB_STORE_ID=store_...

# Protects /api/cron/sweep. Vercel Cron sends this as a Bearer token.
# CRON_SECRET=replace-with-a-long-random-string

# Admin console at /admin. Generate the primary account with:
#   npm run admin:credentials -- --write
# The generated password hash uses scrypt. Never use a plaintext password here.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...
# ADMIN_SESSION_SECRET=at-least-32-random-characters
#
# ADMIN_SESSION_SECRET also derives the AES-256-GCM key that encrypts dynamic
# administrators, IP blocks, the activity log, and stored student identity.
# Rotating it invalidates admin sessions and makes that existing state
# unreadable, so treat it as permanent unless you intend to reset those records.
#
# Additional admin accounts, as comma- or newline-separated
# username:scrypt-hash pairs. Splitting on the first colon keeps the hash intact.
# ADMIN_USERS=tremtem:scrypt$16384$8$1$...

# Set to 1 when running behind a reverse proxy (nginx, Caddy, etc.).
# TRUST_PROXY=1
